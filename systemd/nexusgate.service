[Unit]
Description=NexusGate Sing-box Lightweight Control Panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/nexusgate/nexusgate.env
WorkingDirectory=/opt/nexusgate
ExecStart=/usr/bin/node --expose-gc --max-old-space-size=192 /opt/nexusgate/server.js
Restart=always
RestartSec=2
LimitNOFILE=1048576
MemoryMax=384M

[Install]
WantedBy=multi-user.target
